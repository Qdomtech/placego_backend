# ---------- Server ----------
NODE_ENV=development
PORT=5000

# Comma-separated list of frontend URLs allowed to call this API
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://placego.online,https://www.placego.online

# ---------- Database ----------
# Local:  mongodb://127.0.0.1:27017/placego
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/placego
MONGODB_URI=mongodb://127.0.0.1:27017/placego

# ---------- Auth ----------
# Use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# First admin account (created by: npm run create-admin)
ADMIN_NAME=PlaceGo Admin
ADMIN_EMAIL=admin@placego.online
ADMIN_PASSWORD=ChangeMe@123

# ---------- Email (optional) ----------
# If SMTP_HOST is empty, enquiries are still saved to the database, just no email is sent.
# Gmail: host smtp.gmail.com, port 465, secure true, use an App Password (not your normal password)
# Hostinger: host smtp.hostinger.com, port 465, secure true
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PlaceGo Website <info@placego.online>"
# Where new enquiry notifications go
MAIL_TO=info@placego.online
# Send an automatic "we received your message" reply to the visitor
SEND_AUTO_REPLY=true
